---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      <span data-lang="en">{{ page.title_en | default: page.title }}</span>
      <span data-lang="zh" style="display: none;">{{ page.title_zh | default: page.title }}</span>
    </h1>
    <p class="post-description">
      <span data-lang="en">{{ page.description_en | default: page.description }}</span>
      <span data-lang="zh" style="display: none;">{{ page.description_zh | default: page.description }}</span>
    </p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
